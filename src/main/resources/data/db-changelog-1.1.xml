<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">


    <changeSet id="load-data-training-types" author="Oleksandr@DevDB">
        <loadData tableName="training_types"
                  file="data/trainingTypes.csv"  separator=",">
            <column name="id" header="id" type="NUMERIC"/>
            <column name="training_type_name" header="training_type_name" type="STRING"/>
        </loadData>
    </changeSet>

    <changeSet id="tag-1.2" author="Oleksandr@DevDB">
        <tagDatabase tag="1.2" />
    </changeSet>

</databaseChangeLog>